# Copy to .env on the server:  cp .env.example .env   — never commit .env.

# Database (own Postgres in this stack). Use a long hex string so it's URL-safe:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Owner login. On any machine with Node, from web/:  npm run hash-password -- "your password"
OWNER_PASSWORD_HASH=
OWNER_PASSWORD_SALT=
OWNER_SESSION_SECRET=

APP_TIMEZONE=America/Chicago
# Public URL once the subdomain is chosen, e.g. https://hq.ridwansharif.com
APP_URL=http://localhost:3100
# Once the tunnel is live: APP_URL=https://hq.ridwansharif.com

# Testing from another device on the LAN over plain http:
#   WEB_BIND=0.0.0.0  and  COOKIE_SECURE=false
# Put them back (127.0.0.1 / true) once the Cloudflare Tunnel is live.
WEB_BIND=127.0.0.1
COOKIE_SECURE=true

# ── Notifications ──
# Push keys, generated ONCE (changing them breaks existing phone subscriptions). From web/:
#   npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ridwansharif.com
# Shared secret between the ticker and the web app:  openssl rand -hex 24
CRON_SECRET=
# Morning summary time (24h, APP_TIMEZONE)
DIGEST_TIME=08:00
# Optional Telegram fallback (only used when no phone/browser gets a reminder).
# Reuse the SecondBrain bot token; chat id = your Telegram user id (TELEGRAM_ALLOWED_USER_ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lets the SecondBrain bot post Telegram chat into the HQ Feed (/api/feed/ingest).
# Make one with: openssl rand -hex 24   (leave empty to turn ingest off)
FEED_SECRET=

# Absolute path to the Syncthing copy of the LifeQuest vault on THIS server
LIFEQUEST_VAULT_HOST=

# Backups: ./backups, kept this many days, taken at this hour (24h, server TZ)
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=03

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels). Only for --profile tunnel.
CF_TUNNEL_TOKEN=
